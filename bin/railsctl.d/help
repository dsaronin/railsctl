#!/usr/bin/env bash
# bin/railsctl.d/help
# Display usage syntax, configured services, and command descriptions

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/_common.sh"
railsctl_load_global

SERVICES_LIST="$(railsctl_list_services | paste -sd ', ' -)"

railsctl_status "Usage:"
railsctl_info   "  railsctl init <service> [--dry-run]"
railsctl_info   "  railsctl <service> <command> [options]"
railsctl_info   "  railsctl config [service]"
railsctl_info   "  railsctl help"
echo

railsctl_status "Configured Services:"
railsctl_info   "  ${SERVICES_LIST:-none}"
echo

railsctl_status "<service> Deployment Commands:"
cat <<'EOF'
  init      Provision a new <service>  [--dry-run]
  deploy    Safely deploy new version of a <service> [--dry-run] [--redeploy] [--no-backup]
  start     Start the <service> and verify
  stop      Cleanly stop the <service>
  suspend   Enable Nginx 503 maintenance mode and stop <service>
  resume    Start <service>, verify 
  backup    Backup SQLite; prune older snapshots
  test      Run the isolated test suite against a temporary snapshot database
  status    Display <service> state and stats
  version   Display railsctl version, <service> version, and Git SHA
  config    Display configuration parameters for <service> or global railsctl
  help      This message
EOF
