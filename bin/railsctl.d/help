#!/usr/bin/env bash
# bin/railsctl.d/help
# Display usage syntax, configured services, and command descriptions

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/_common.sh"
railsctl_load_global

SERVICES_LIST="$(railsctl_list_services | paste -sd ', ' -)"

railsctl_status "Usage:"
railsctl_info   "  railsctl <service> <command> [options]"
railsctl_info   "  railsctl config [service]"
railsctl_info   "  railsctl help"
echo

railsctl_status "Configured Services:"
railsctl_info   "  ${SERVICES_LIST:-none}"
echo

railsctl_status "Lifecycle & Deployment Commands:"
cat <<'EOF'
  deploy    Suspend, backup DB, pull fast-forward, bundle, migrate, precompile, resume & status 
            [--dry-run] [--redeploy] [--no-backup]
  start     Start the systemd unit and verify the HTTP health check
  stop      Cleanly stop the systemd unit
  suspend   Enable Nginx 503 maintenance mode and stop Puma
  resume    Start Puma, verify HTTP health check, and clear maintenance mode
  backup    Create a WAL-safe online SQLite backup and prune older snapshots
  test      Run the isolated test suite against a temporary snapshot database
  status    Display systemd state, PID, memory, uptime, Git commit, and app version
  version   Display railsctl version, service app version constant, and Git SHA
  config    Display resolved configuration parameters for <service> or global railsctl
  help      Show this help message
EOF
