#!/usr/bin/env bash
# bin/railsctl.d/stop
# Cleanly stop the service systemd unit

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/_common.sh"
railsctl_init required "$@"

if ! systemctl is-active --quiet "${UNIT_NAME}"; then
  railsctl_warn "${SERVICE_DISPLAY_NAME} (${UNIT_NAME}) is already stopped."
  railsctl_log "STOP" "unit=${UNIT_NAME} status=already_stopped"
  exit 0
fi

railsctl_status "Stopping ${SERVICE_DISPLAY_NAME} (${UNIT_NAME})..."
sudo systemctl stop "${UNIT_NAME}"

if systemctl is-active --quiet "${UNIT_NAME}"; then
  railsctl_die "Failed to stop ${UNIT_NAME}."
fi

railsctl_info "${SERVICE_DISPLAY_NAME} (${UNIT_NAME}) stopped."
railsctl_log "STOP" "unit=${UNIT_NAME} status=stopped"
