#!/usr/bin/env bash
# bin/railsctl.d/init
# Phase 1: Interactive prompting, pre-flight dry-run gate, template validation & rollback scaffold

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "${SCRIPT_DIR}/_common.sh"

###############################################################################
# State initialization
###############################################################################
init_reset_variables() {
  OPT_DRY_RUN=false

  RAILSCTL_TEMPLATES_DIR="${RAILSCTL_ROOT}/templates"

  INIT_SERVICE_NAME=""
  INIT_DISPLAY_NAME=""
  INIT_GIT_URL=""
  INIT_GIT_BRANCH="main"
  INIT_SERVICE_USER=""
  INIT_SERVICE_GROUP=""
  INIT_UNIT_NAME=""
  INIT_SERVICE_HOME=""
  INIT_PUMA_PORT=""
  INIT_NGINX_PORT=""
  INIT_NGINX_ID=""
  INIT_HOSTNAME=""
  INIT_RUBY_WRAPPER_DIR="/usr/local/rvm/wrappers/ruby-3.3.11"
  INIT_VERSION_CONST=""
  INIT_VERSION_FILE_REL=""
  INIT_SECRET_KEY_BASE=""

  # Rollback state trackers (mutated only in Phases 2-5)
  ROLLBACK_ARMED=false
  ROLLBACK_IN_PROGRESS=false
  CREATED_GROUP=false
  CREATED_USER=false
  ADDED_GROUP_MEMBERS=()
  CREATED_HOME=false
  CREATED_CONF=false
  CREATED_LOG_DIR=false
  CREATED_SYSTEMD=false
  CREATED_NGINX_AVAIL=false
  CREATED_NGINX_ENABLED=false
}

###############################################################################
# Rollback scaffold & error trap
###############################################################################
init_on_exit() {
  local exit_rc="$1"

  if [[ ${exit_rc} -ne 0 ]] && [[ "${ROLLBACK_ARMED}" == "true" ]] && [[ "${ROLLBACK_IN_PROGRESS}" != "true" ]]; then
    railsctl_err "Provisioning failed (exit ${exit_rc}). Initiating clean rollback..."
    init_rollback
  fi
}

init_rollback_phase_2() {
  if [[ "${CREATED_HOME}" == "true" ]] && [[ -n "${INIT_SERVICE_HOME}" ]] && [[ "${INIT_SERVICE_HOME}" == /home/* ]]; then
    railsctl_warn "  Rollback: removing directory tree ${INIT_SERVICE_HOME}..."
    sudo rm -rf "${INIT_SERVICE_HOME}"
    CREATED_HOME=false
  fi

  local entry member grp
  for entry in "${ADDED_GROUP_MEMBERS[@]}"; do
    member="${entry%%:*}"
    grp="${entry#*:}"
    railsctl_warn "  Rollback: removing '${member}' from group '${grp}'..."
    sudo gpasswd -d "${member}" "${grp}" >/dev/null 2>&1 || true
  done
  ADDED_GROUP_MEMBERS=()

  if [[ "${CREATED_USER}" == "true" ]] && id -u "${INIT_SERVICE_USER}" >/dev/null 2>&1; then
    railsctl_warn "  Rollback: deleting system user '${INIT_SERVICE_USER}'..."
    sudo userdel "${INIT_SERVICE_USER}" >/dev/null 2>&1 || true
    CREATED_USER=false
  fi

  if [[ "${CREATED_GROUP}" == "true" ]] && getent group "${INIT_SERVICE_GROUP}" >/dev/null 2>&1; then
    railsctl_warn "  Rollback: deleting system group '${INIT_SERVICE_GROUP}'..."
    sudo groupdel "${INIT_SERVICE_GROUP}" >/dev/null 2>&1 || true
    CREATED_GROUP=false
  fi
}

init_rollback_phase_4() {
  local conf_file="${RAILSCTL_CONFIG_DIR}/${INIT_SERVICE_NAME}.conf"
  local log_dir="${RAILSCTL_SERVICES_DIR}/${INIT_SERVICE_NAME}"

  if [[ "${CREATED_LOG_DIR}" == "true" ]] && [[ -n "${INIT_SERVICE_NAME}" ]] && [[ -d "${log_dir}" ]]; then
    railsctl_warn "  Rollback: removing audit log directory ${log_dir}..."
    rm -rf "${log_dir}"
    CREATED_LOG_DIR=false
  fi

  if [[ "${CREATED_CONF}" == "true" ]] && [[ -n "${INIT_SERVICE_NAME}" ]] && [[ -f "${conf_file}" ]]; then
    railsctl_warn "  Rollback: removing service config ${conf_file}..."
    rm -f "${conf_file}"
    CREATED_CONF=false
  fi
}

init_rollback_phase_5() {
  local nginx_avail="/etc/nginx/sites-available/${INIT_SERVICE_NAME}.conf"
  local nginx_enabled="/etc/nginx/sites-enabled/${INIT_SERVICE_NAME}.conf"
  local unit_file="/etc/systemd/system/${INIT_UNIT_NAME}"
  local nginx_changed=false

  if [[ "${CREATED_NGINX_ENABLED}" == "true" ]] && [[ -L "${nginx_enabled}" || -e "${nginx_enabled}" ]]; then
    railsctl_warn "  Rollback: removing Nginx enabled symlink ${nginx_enabled}..."
    sudo rm -f "${nginx_enabled}"
    CREATED_NGINX_ENABLED=false
    nginx_changed=true
  fi

  if [[ "${CREATED_NGINX_AVAIL}" == "true" ]] && [[ -f "${nginx_avail}" ]]; then
    railsctl_warn "  Rollback: removing Nginx site config ${nginx_avail}..."
    sudo rm -f "${nginx_avail}"
    CREATED_NGINX_AVAIL=false
    nginx_changed=true
  fi

  if [[ "${nginx_changed}" == "true" ]]; then
    if sudo nginx -t >/dev/null 2>&1; then
      sudo systemctl reload nginx >/dev/null 2>&1 || true
    fi
  fi

  if [[ "${CREATED_SYSTEMD}" == "true" ]] && [[ -f "${unit_file}" ]]; then
    railsctl_warn "  Rollback: disabling and removing systemd unit ${unit_file}..."
    sudo systemctl stop "${INIT_UNIT_NAME}" >/dev/null 2>&1 || true
    sudo systemctl disable "${INIT_UNIT_NAME}" >/dev/null 2>&1 || true
    sudo rm -f "${unit_file}"
    sudo systemctl daemon-reload >/dev/null 2>&1 || true
    sudo systemctl reset-failed >/dev/null 2>&1 || true
    CREATED_SYSTEMD=false
  fi
}

init_rollback() {
  ROLLBACK_IN_PROGRESS=true
  set +e

  railsctl_warn "Rollback: reverting artifacts created during this init run..."
  # Reverse-order teardown steps:
  #   1. Nginx (Phase 5)
  #   2. Systemd (Phase 5)
  #   3. railsctl registration (Phase 4)
  #   4. Filesystem & OS user/group (Phase 2)
  init_rollback_phase_5
  init_rollback_phase_4
  init_rollback_phase_2

  railsctl_warn "Rollback complete."
  ROLLBACK_ARMED=false
  ROLLBACK_IN_PROGRESS=false
}

###############################################################################
# Argument parsing & interactive prompting helpers
###############################################################################
init_parse_args() {
  if [[ $# -lt 1 ]]; then
    railsctl_die "Usage: railsctl init <service> [--dry-run]"
  fi

  INIT_SERVICE_NAME="${1,,}"
  shift 1

  railsctl_parse_args --dry-run -- "$@"

  railsctl_info "Init target: service='${INIT_SERVICE_NAME}', dry-run=${OPT_DRY_RUN}"
}

init_prompt_value() {
  local var_name="$1"
  local label="$2"
  local default_val="$3"
  local required="${4:-false}"
  local input_val=""

  while true; do
    if [[ -n "${default_val}" ]]; then
      read -r -p "  ${label} [${default_val}]: " input_val
      input_val="${input_val:-${default_val}}"
    else
      read -r -p "  ${label}: " input_val
    fi

    if [[ "${required}" == "true" ]] && [[ -z "${input_val}" ]]; then
      railsctl_warn "  A value is required for '${label}'."
      continue
    fi

    printf -v "${var_name}" '%s' "${input_val}"
    break
  done
}

init_prompt_parameters() {
  local default_display="${INIT_SERVICE_NAME^^}"
  local default_const_prefix="${INIT_SERVICE_NAME//-/ }"
  local default_const=""
  local word
  for word in ${default_const_prefix}; do
    default_const+="${word^}"
  done
  default_const="${default_const}::VERSION"

  railsctl_status "Phase 1: Collecting provisioning parameters for '${INIT_SERVICE_NAME}'..."

  init_prompt_value INIT_DISPLAY_NAME     "Display Name"      "${default_display}" true
  init_prompt_value INIT_GIT_URL          "Git Repo URL"      ""                   true
  init_prompt_value INIT_GIT_BRANCH       "Git Branch"        "main"               true
  init_prompt_value INIT_SERVICE_USER     "System User"       "${INIT_SERVICE_NAME}" true
  init_prompt_value INIT_SERVICE_GROUP    "System Group"      "${INIT_SERVICE_NAME}" true
  init_prompt_value INIT_PUMA_PORT        "Puma Port"         "9001"               true
  init_prompt_value INIT_NGINX_PORT       "Nginx Port"        "9011"               true
  init_prompt_value INIT_RUBY_WRAPPER_DIR "Ruby Wrapper Dir"  "${INIT_RUBY_WRAPPER_DIR}" true
  init_prompt_value INIT_VERSION_CONST    "Version Constant"  "${default_const}"   true
  init_prompt_value INIT_VERSION_FILE_REL "Version File (rel)" "lib/${INIT_SERVICE_NAME}/version.rb" true

  INIT_UNIT_NAME="${INIT_SERVICE_NAME}.service"
  INIT_SERVICE_HOME="/home/${INIT_SERVICE_NAME}"
  INIT_NGINX_ID="${INIT_SERVICE_NAME//-/_}"
  INIT_HOSTNAME="$(hostname -s)"
}

###############################################################################
# Phase 1 pre-flight & dry-run validation helpers
###############################################################################
init_check_service_name() {
  if [[ ! "${INIT_SERVICE_NAME}" =~ ^[a-z][a-z0-9_-]*$ ]]; then
    railsctl_die "Invalid service name '${INIT_SERVICE_NAME}'. Must match ^[a-z][a-z0-9_-]*$"
  fi
  INIT_UNIT_NAME="${INIT_SERVICE_NAME}.service"
  INIT_SERVICE_HOME="/home/${INIT_SERVICE_NAME}"
  railsctl_info "  Verified service name syntax: ${INIT_SERVICE_NAME}"
}

init_check_no_collisions() {
  local conf_file="${RAILSCTL_CONFIG_DIR}/${INIT_SERVICE_NAME}.conf"
  local unit_file="/etc/systemd/system/${INIT_UNIT_NAME}"
  local nginx_avail="/etc/nginx/sites-available/${INIT_SERVICE_NAME}.conf"
  local nginx_enabled="/etc/nginx/sites-enabled/${INIT_SERVICE_NAME}.conf"

  [[ ! -e "${conf_file}" ]]     || railsctl_die "Service config already exists: ${conf_file}"
  [[ ! -e "${INIT_SERVICE_HOME}" ]] || railsctl_die "Service home already exists: ${INIT_SERVICE_HOME}"
  [[ ! -e "${unit_file}" ]]     || railsctl_die "Systemd unit already exists: ${unit_file}"
  [[ ! -e "${nginx_avail}" ]]   || railsctl_die "Nginx site already exists: ${nginx_avail}"
  [[ ! -e "${nginx_enabled}" ]] || railsctl_die "Nginx site symlink already exists: ${nginx_enabled}"

  railsctl_info "  Verified no existing config, home, systemd, or Nginx collisions."
}

init_validate_port_value() {
  local label="$1"
  local port="$2"

  if [[ ! "${port}" =~ ^[0-9]+$ ]] || (( port < 1024 || port > 65535 )); then
    railsctl_die "Invalid ${label} '${port}'. Must be an integer between 1024 and 65535."
  fi

  if ss -H -ltn | grep -Eq "[:.]${port}[[:space:]]"; then
    railsctl_die "${label} ${port} is currently bound by a listening socket."
  fi

  if compgen -G "/etc/nginx/sites-available/*.conf" >/dev/null; then
    if grep -Eq "(listen[[:space:]]+${port};|127\.0\.0\.1:${port}\b)" /etc/nginx/sites-available/*.conf; then
      railsctl_die "${label} ${port} is already referenced in /etc/nginx/sites-available/*.conf."
    fi
  fi
}

init_check_ports() {
  if [[ "${INIT_PUMA_PORT}" == "${INIT_NGINX_PORT}" ]]; then
    railsctl_die "Puma port (${INIT_PUMA_PORT}) and Nginx port (${INIT_NGINX_PORT}) must differ."
  fi

  init_validate_port_value "Puma port"  "${INIT_PUMA_PORT}"
  init_validate_port_value "Nginx port" "${INIT_NGINX_PORT}"
  railsctl_info "  Verified ports available: Puma=${INIT_PUMA_PORT}, Nginx=${INIT_NGINX_PORT}"
}

init_check_runtime_and_git() {
  [[ -x "${INIT_RUBY_WRAPPER_DIR}/ruby" ]]   || railsctl_die "Ruby binary not executable: ${INIT_RUBY_WRAPPER_DIR}/ruby"
  [[ -x "${INIT_RUBY_WRAPPER_DIR}/bundle" ]] || railsctl_die "Bundler binary not executable: ${INIT_RUBY_WRAPPER_DIR}/bundle"
  railsctl_info "  Verified Ruby wrapper dir: ${INIT_RUBY_WRAPPER_DIR}"

  railsctl_info "  Checking Git remote reachability (${INIT_GIT_URL}, branch '${INIT_GIT_BRANCH}')..."
  local remote_ref
  remote_ref="$(git ls-remote --heads "${INIT_GIT_URL}" "${INIT_GIT_BRANCH}" 2>/dev/null || true)"
  if [[ -z "${remote_ref}" ]]; then
    railsctl_die "Unable to resolve branch '${INIT_GIT_BRANCH}' on Git remote: ${INIT_GIT_URL}"
  fi
  railsctl_info "  Verified Git remote branch '${INIT_GIT_BRANCH}' reachable."
}

init_render_template() {
  local tmpl_path="$1"
  local dest_path="$2"
  local secret_val="${INIT_SECRET_KEY_BASE:-DRY_RUN_PLACEHOLDER}"

  sed \
    -e "s|@@SERVICE_NAME@@|${INIT_SERVICE_NAME}|g" \
    -e "s|@@SERVICE_DISPLAY_NAME@@|${INIT_DISPLAY_NAME}|g" \
    -e "s|@@SERVICE_USER@@|${INIT_SERVICE_USER}|g" \
    -e "s|@@SERVICE_GROUP@@|${INIT_SERVICE_GROUP}|g" \
    -e "s|@@UNIT_NAME@@|${INIT_UNIT_NAME}|g" \
    -e "s|@@SERVICE_HOME@@|${INIT_SERVICE_HOME}|g" \
    -e "s|@@GIT_BRANCH@@|${INIT_GIT_BRANCH}|g" \
    -e "s|@@RUBY_WRAPPER_DIR@@|${INIT_RUBY_WRAPPER_DIR}|g" \
    -e "s|@@VERSION_CONST@@|${INIT_VERSION_CONST}|g" \
    -e "s|@@VERSION_FILE_REL@@|${INIT_VERSION_FILE_REL}|g" \
    -e "s|@@PUMA_PORT@@|${INIT_PUMA_PORT}|g" \
    -e "s|@@NGINX_PORT@@|${INIT_NGINX_PORT}|g" \
    -e "s|@@NGINX_ID@@|${INIT_NGINX_ID}|g" \
    -e "s|@@HOSTNAME@@|${INIT_HOSTNAME}|g" \
    -e "s|@@SECRET_KEY_BASE@@|${secret_val}|g" \
    "${tmpl_path}" > "${dest_path}"
}

init_validate_phase_1() {
  local templates=(service.conf.tmpl service.env.tmpl systemd.service.tmpl nginx.conf.tmpl)
  local tmp_dir
  tmp_dir="$(mktemp -d)"

  local tmpl src out
  for tmpl in "${templates[@]}"; do
    src="${RAILSCTL_TEMPLATES_DIR}/${tmpl}"
    if [[ ! -r "${src}" ]]; then
      rm -rf "${tmp_dir}"
      railsctl_die "Missing or unreadable template: ${src}"
    fi

    out="${tmp_dir}/${tmpl%.tmpl}"
    init_render_template "${src}" "${out}"

    if grep -Eq '@@[A-Z0-9_]+@@' "${out}"; then
      railsctl_err "Unresolved placeholder tokens found in rendered ${tmpl}:"
      railsctl_err "$(grep -En '@@[A-Z0-9_]+@@' "${out}")"
      rm -rf "${tmp_dir}"
      railsctl_die "Template validation failed for ${tmpl}."
    fi
  done

  rm -rf "${tmp_dir}"
  railsctl_info "  Validated all 4 templates render cleanly with zero unresolved tokens."
}

init_print_summary() {
  railsctl_status "Dry-Run Pre-Flight Summary for '${INIT_SERVICE_NAME}':"
  railsctl_info "  Display Name     : ${INIT_DISPLAY_NAME}"
  railsctl_info "  Git Repository   : ${INIT_GIT_URL} (branch: ${INIT_GIT_BRANCH})"
  railsctl_info "  System User/Group: ${INIT_SERVICE_USER}:${INIT_SERVICE_GROUP}"
  railsctl_info "  Service Home     : ${INIT_SERVICE_HOME}"
  railsctl_info "  Puma Bind        : http://127.0.0.1:${INIT_PUMA_PORT}"
  railsctl_info "  Nginx Listen     : port ${INIT_NGINX_PORT} (/etc/nginx/sites-available/${INIT_SERVICE_NAME}.conf)"
  railsctl_info "  Systemd Unit     : /etc/systemd/system/${INIT_UNIT_NAME}"
  railsctl_info "  railsctl Config  : ${RAILSCTL_CONFIG_DIR}/${INIT_SERVICE_NAME}.conf"
  railsctl_info "  Ruby Wrapper     : ${INIT_RUBY_WRAPPER_DIR}"
  railsctl_info "  Version Tracking : ${INIT_VERSION_CONST} (${INIT_VERSION_FILE_REL})"
}

init_confirm_proceed() {
  if [[ "${OPT_DRY_RUN}" == "true" ]]; then
    railsctl_status "Dry-run complete: all pre-flight checks and template validations passed. No changes applied."
    return 10
  fi

  local answer=""
  read -r -p "Proceed with provisioning '${INIT_SERVICE_NAME}'? [y/N]: " answer
  case "${answer}" in
    y|Y|yes|YES)
      return 0
      ;;
    *)
      railsctl_warn "Provisioning cancelled by operator. No changes applied."
      return 11
      ;;
  esac
}

init_preflight() {
  init_check_service_name
  init_check_no_collisions
  init_prompt_parameters

  railsctl_status "Phase 1: Running built-in dry-run pre-flight checks..."
  init_check_ports
  init_check_runtime_and_git
  init_validate_phase_1
  init_print_summary
  init_confirm_proceed
}

###############################################################################
# Phase 2: OS user, group & directory skeleton
###############################################################################
init_add_user_to_group_if_missing() {
  local member="$1"
  local grp="$2"

  if ! id -u "${member}" >/dev/null 2>&1; then
    railsctl_die "Cannot add non-existent user '${member}' to group '${grp}'."
  fi
  if ! getent group "${grp}" >/dev/null 2>&1; then
    railsctl_die "Cannot add '${member}' to non-existent group '${grp}'."
  fi

  if id -nG "${member}" | tr ' ' '\n' | grep -Fxq "${grp}"; then
    railsctl_info "  User '${member}' is already a member of '${grp}'."
    return 0
  fi

  sudo usermod -aG "${grp}" "${member}"
  ADDED_GROUP_MEMBERS+=("${member}:${grp}")
  railsctl_info "  Added user '${member}' to group '${grp}'."
}

init_provision_user_and_dirs() {
  railsctl_status "Phase 2: Provisioning OS user, group, and directory skeleton..."

  if getent group "${INIT_SERVICE_GROUP}" >/dev/null 2>&1; then
    railsctl_info "  Using existing group '${INIT_SERVICE_GROUP}'."
  else
    sudo groupadd --system "${INIT_SERVICE_GROUP}"
    CREATED_GROUP=true
    railsctl_info "  Created system group '${INIT_SERVICE_GROUP}'."
  fi

  if id -u "${INIT_SERVICE_USER}" >/dev/null 2>&1; then
    railsctl_info "  Using existing user '${INIT_SERVICE_USER}'."
  else
    sudo useradd \
      --system \
      --gid "${INIT_SERVICE_GROUP}" \
      --home-dir "${INIT_SERVICE_HOME}" \
      --shell /usr/sbin/nologin \
      "${INIT_SERVICE_USER}"
    CREATED_USER=true
    railsctl_info "  Created system user '${INIT_SERVICE_USER}' (home: ${INIT_SERVICE_HOME})."
  fi

  init_add_user_to_group_if_missing "www-data" "${INIT_SERVICE_GROUP}"
  init_add_user_to_group_if_missing "${USER}" "${INIT_SERVICE_GROUP}"
  if getent group "rvm" >/dev/null 2>&1; then
    init_add_user_to_group_if_missing "${INIT_SERVICE_USER}" "rvm"
  fi

  sudo install -d -o "${INIT_SERVICE_USER}" -g "${INIT_SERVICE_GROUP}" -m 0750 "${INIT_SERVICE_HOME}"
  CREATED_HOME=true

  sudo install -d -o "${INIT_SERVICE_USER}" -g "${INIT_SERVICE_GROUP}" -m 0755 "${INIT_SERVICE_HOME}/app"
  sudo install -d -o "${INIT_SERVICE_USER}" -g "${INIT_SERVICE_GROUP}" -m 0750 "${INIT_SERVICE_HOME}/data"
  sudo install -d -o "${INIT_SERVICE_USER}" -g "${INIT_SERVICE_GROUP}" -m 0700 "${INIT_SERVICE_HOME}/config"
  sudo install -d -o "${INIT_SERVICE_USER}" -g "${INIT_SERVICE_GROUP}" -m 0750 "${INIT_SERVICE_HOME}/backups"

  railsctl_info "  Created directory skeleton under ${INIT_SERVICE_HOME}."
}

init_verify_dir_spec() {
  local dir_path="$1"
  local expected_owner="$2"
  local expected_group="$3"
  local expected_mode="$4"

  sudo test -d "${dir_path}" || railsctl_die "Validation failed: directory missing: ${dir_path}"

  local actual_spec expected_spec
  actual_spec="$(sudo stat -c '%U:%G:%a' "${dir_path}")"
  expected_spec="${expected_owner}:${expected_group}:${expected_mode}"

  if [[ "${actual_spec}" != "${expected_spec}" ]]; then
    railsctl_die "Validation failed on ${dir_path}: expected ${expected_spec}, got ${actual_spec}"
  fi
}

init_validate_phase_2() {
  getent group "${INIT_SERVICE_GROUP}" >/dev/null 2>&1 || railsctl_die "Validation failed: group '${INIT_SERVICE_GROUP}' not found."
  id -u "${INIT_SERVICE_USER}" >/dev/null 2>&1        || railsctl_die "Validation failed: user '${INIT_SERVICE_USER}' not found."

  id -nG "www-data" | tr ' ' '\n' | grep -Fxq "${INIT_SERVICE_GROUP}" \
    || railsctl_die "Validation failed: 'www-data' not in group '${INIT_SERVICE_GROUP}'."
  id -nG "${USER}" | tr ' ' '\n' | grep -Fxq "${INIT_SERVICE_GROUP}" \
    || railsctl_die "Validation failed: '${USER}' not in group '${INIT_SERVICE_GROUP}'."

  init_verify_dir_spec "${INIT_SERVICE_HOME}"         "${INIT_SERVICE_USER}" "${INIT_SERVICE_GROUP}" "750"
  init_verify_dir_spec "${INIT_SERVICE_HOME}/app"     "${INIT_SERVICE_USER}" "${INIT_SERVICE_GROUP}" "755"
  init_verify_dir_spec "${INIT_SERVICE_HOME}/data"    "${INIT_SERVICE_USER}" "${INIT_SERVICE_GROUP}" "750"
  init_verify_dir_spec "${INIT_SERVICE_HOME}/config"  "${INIT_SERVICE_USER}" "${INIT_SERVICE_GROUP}" "700"
  init_verify_dir_spec "${INIT_SERVICE_HOME}/backups" "${INIT_SERVICE_USER}" "${INIT_SERVICE_GROUP}" "750"

  railsctl_info "  Phase 2 validation passed: user, group, memberships, and directory modes verified."
}

###############################################################################
# Phase 3: Repository clone, maintenance flag & environment file
###############################################################################
init_clone_repository() {
  railsctl_info "  Cloning '${INIT_GIT_URL}' (branch '${INIT_GIT_BRANCH}') into ${INIT_SERVICE_HOME}/app..."
  sudo -u "${INIT_SERVICE_USER}" git clone \
    --branch "${INIT_GIT_BRANCH}" \
    --single-branch \
    "${INIT_GIT_URL}" \
    "${INIT_SERVICE_HOME}/app"

  sudo install -d -o "${INIT_SERVICE_USER}" -g "${INIT_SERVICE_GROUP}" -m 0775 "${INIT_SERVICE_HOME}/app/tmp"
  sudo install -d -o "${INIT_SERVICE_USER}" -g "${INIT_SERVICE_GROUP}" -m 0775 "${INIT_SERVICE_HOME}/app/tmp/pids"

  sudo -u "${INIT_SERVICE_USER}" touch "${INIT_SERVICE_HOME}/app/tmp/maintenance.flag"
  sudo chmod 0644 "${INIT_SERVICE_HOME}/app/tmp/maintenance.flag"
  railsctl_info "  Created tmp/pids and enabled maintenance.flag (HTTP 503 until first deploy)."
}

init_generate_env_file() {
  local env_dest="${INIT_SERVICE_HOME}/config/${INIT_SERVICE_NAME}.env"
  local tmp_env
  tmp_env="$(mktemp)"

  INIT_SECRET_KEY_BASE="$("${INIT_RUBY_WRAPPER_DIR}/ruby" -rsecurerandom -e 'puts SecureRandom.hex(64)')"
  if [[ ${#INIT_SECRET_KEY_BASE} -ne 128 ]]; then
    rm -f "${tmp_env}"
    railsctl_die "Failed to generate 128-character SECRET_KEY_BASE."
  fi

  init_render_template "${RAILSCTL_TEMPLATES_DIR}/service.env.tmpl" "${tmp_env}"
  sudo install -o "${INIT_SERVICE_USER}" -g "${INIT_SERVICE_GROUP}" -m 0600 "${tmp_env}" "${env_dest}"
  rm -f "${tmp_env}"

  railsctl_info "  Generated production environment file: ${env_dest} (mode 0600)."
}

init_provision_repo_and_env() {
  railsctl_status "Phase 3: Cloning repository, setting maintenance flag, and generating environment file..."
  init_clone_repository
  init_generate_env_file
}

init_validate_phase_3() {
  local app_dir="${INIT_SERVICE_HOME}/app"
  local maint_flag="${app_dir}/tmp/maintenance.flag"
  local env_dest="${INIT_SERVICE_HOME}/config/${INIT_SERVICE_NAME}.env"

  sudo -u "${INIT_SERVICE_USER}" git -C "${app_dir}" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    || railsctl_die "Validation failed: ${app_dir} is not a valid Git working tree."

  local current_branch
  current_branch="$(sudo -u "${INIT_SERVICE_USER}" git -C "${app_dir}" rev-parse --abbrev-ref HEAD)"
  if [[ "${current_branch}" != "${INIT_GIT_BRANCH}" ]]; then
    railsctl_die "Validation failed: expected branch '${INIT_GIT_BRANCH}', got '${current_branch}'."
  fi

  sudo test -f "${maint_flag}" \
    || railsctl_die "Validation failed: maintenance flag missing: ${maint_flag}"

  sudo test -f "${env_dest}" \
    || railsctl_die "Validation failed: environment file missing: ${env_dest}"

  local actual_env_spec expected_env_spec
  actual_env_spec="$(sudo stat -c '%U:%G:%a' "${env_dest}")"
  expected_env_spec="${INIT_SERVICE_USER}:${INIT_SERVICE_GROUP}:600"
  if [[ "${actual_env_spec}" != "${expected_env_spec}" ]]; then
    railsctl_die "Validation failed on ${env_dest}: expected ${expected_env_spec}, got ${actual_env_spec}"
  fi

  sudo -u "${INIT_SERVICE_USER}" test -r "${env_dest}" \
    || railsctl_die "Validation failed: ${env_dest} not readable by ${INIT_SERVICE_USER}."

  if ! sudo grep -Eq '^SECRET_KEY_BASE=[0-9a-f]{128}$' "${env_dest}"; then
    railsctl_die "Validation failed: invalid or missing SECRET_KEY_BASE in ${env_dest}."
  fi

  railsctl_info "  Phase 3 validation passed: Git branch, maintenance flag, and ${INIT_SERVICE_NAME}.env verified."
}

###############################################################################
# Phase 4: railsctl configuration registration & audit logging
###############################################################################
init_provision_railsctl_registration() {
  local conf_dest="${RAILSCTL_CONFIG_DIR}/${INIT_SERVICE_NAME}.conf"
  local log_dir="${RAILSCTL_SERVICES_DIR}/${INIT_SERVICE_NAME}"

  railsctl_status "Phase 4: Registering '${INIT_SERVICE_NAME}' in railsctl and initializing audit log..."

  mkdir -p "${RAILSCTL_CONFIG_DIR}"
  init_render_template "${RAILSCTL_TEMPLATES_DIR}/service.conf.tmpl" "${conf_dest}"
  chmod 0644 "${conf_dest}"
  CREATED_CONF=true
  railsctl_info "  Created service configuration: ${conf_dest} (mode 0644)."

  mkdir -p "${log_dir}"
  CREATED_LOG_DIR=true

  SERVICE_NAME="${INIT_SERVICE_NAME}"
  railsctl_log "INIT" "service=${INIT_SERVICE_NAME} user=${INIT_SERVICE_USER} group=${INIT_SERVICE_GROUP} puma_port=${INIT_PUMA_PORT} nginx_port=${INIT_NGINX_PORT} repo=${INIT_GIT_URL} branch=${INIT_GIT_BRANCH}"
  railsctl_info "  Initialized service audit log: ${log_dir}/railsctl.log"
}

init_validate_phase_4() {
  local conf_dest="${RAILSCTL_CONFIG_DIR}/${INIT_SERVICE_NAME}.conf"
  local log_file="${RAILSCTL_SERVICES_DIR}/${INIT_SERVICE_NAME}/railsctl.log"

  [[ -f "${conf_dest}" ]] || railsctl_die "Validation failed: service config missing: ${conf_dest}"
  bash -n "${conf_dest}"   || railsctl_die "Validation failed: syntax error in ${conf_dest}"

  "${RAILSCTL_COMMANDS_DIR}/config" "${INIT_SERVICE_NAME}" >/dev/null \
    || railsctl_die "Validation failed: 'railsctl config ${INIT_SERVICE_NAME}' exited non-zero."

  [[ -f "${log_file}" ]] && [[ -w "${log_file}" ]] \
    || railsctl_die "Validation failed: audit log missing or not writable: ${log_file}"

  railsctl_info "  Phase 4 validation passed: ${INIT_SERVICE_NAME}.conf syntax, config resolution, and audit log verified."
}

###############################################################################
# Phase 5: Systemd unit, Nginx reverse proxy & final handoff
###############################################################################
init_provision_systemd() {
  local unit_dest="/etc/systemd/system/${INIT_UNIT_NAME}"
  local tmp_unit
  tmp_unit="$(mktemp)"

  init_render_template "${RAILSCTL_TEMPLATES_DIR}/systemd.service.tmpl" "${tmp_unit}"
  sudo install -o root -g root -m 0644 "${tmp_unit}" "${unit_dest}"
  rm -f "${tmp_unit}"
  CREATED_SYSTEMD=true

  sudo systemctl daemon-reload
  sudo systemctl enable "${INIT_UNIT_NAME}" >/dev/null
  railsctl_info "  Installed and enabled systemd unit: ${unit_dest} (kept stopped for initial deploy)."
}

init_provision_nginx() {
  local nginx_avail="/etc/nginx/sites-available/${INIT_SERVICE_NAME}.conf"
  local nginx_enabled="/etc/nginx/sites-enabled/${INIT_SERVICE_NAME}.conf"
  local tmp_nginx
  tmp_nginx="$(mktemp)"

  init_render_template "${RAILSCTL_TEMPLATES_DIR}/nginx.conf.tmpl" "${tmp_nginx}"
  sudo install -o root -g root -m 0644 "${tmp_nginx}" "${nginx_avail}"
  rm -f "${tmp_nginx}"
  CREATED_NGINX_AVAIL=true

  sudo ln -s "${nginx_avail}" "${nginx_enabled}"
  CREATED_NGINX_ENABLED=true

  sudo nginx -t >/dev/null 2>&1 || railsctl_die "Nginx configuration test (nginx -t) failed for ${nginx_avail}."
  sudo systemctl reload nginx
  railsctl_info "  Installed, verified, and reloaded Nginx site: ${nginx_avail} (port ${INIT_NGINX_PORT})."
}

init_provision_runtime_and_proxy() {
  railsctl_status "Phase 5: Provisioning systemd unit and Nginx reverse proxy..."
  init_provision_systemd
  init_provision_nginx
}

init_validate_phase_5() {
  local unit_dest="/etc/systemd/system/${INIT_UNIT_NAME}"
  local nginx_avail="/etc/nginx/sites-available/${INIT_SERVICE_NAME}.conf"
  local nginx_enabled="/etc/nginx/sites-enabled/${INIT_SERVICE_NAME}.conf"

  [[ "$(systemctl is-enabled "${INIT_UNIT_NAME}" 2>/dev/null || true)" == "enabled" ]] \
    || railsctl_die "Validation failed: ${INIT_UNIT_NAME} is not enabled."

  sudo systemd-analyze verify "${unit_dest}" >/dev/null 2>&1 \
    || railsctl_die "Validation failed: systemd-analyze verify failed for ${unit_dest}."

  [[ -L "${nginx_enabled}" ]] && [[ -f "${nginx_avail}" ]] \
    || railsctl_die "Validation failed: Nginx site symlink or config missing for ${INIT_SERVICE_NAME}."

  sudo nginx -t >/dev/null 2>&1 \
    || railsctl_die "Validation failed: nginx -t reported errors."

  local http_code
  http_code="$(curl -s -o /dev/null -w '%{http_code}' "http://127.0.0.1:${INIT_NGINX_PORT}/" || true)"
  if [[ "${http_code}" != "503" ]]; then
    railsctl_die "Validation failed: expected HTTP 503 maintenance response on port ${INIT_NGINX_PORT}, got HTTP ${http_code}."
  fi

  railsctl_info "  Phase 5 validation passed: systemd unit enabled, Nginx verified, and port ${INIT_NGINX_PORT} serving HTTP 503."
}

init_print_handoff() {
  railsctl_status "Provisioning complete for '${INIT_SERVICE_NAME}'."
  railsctl_info "Next steps:"
  railsctl_info "  1. Execute initial deployment (bundle, migrate, precompile, start & health check):"
  railsctl_info "       railsctl ${INIT_SERVICE_NAME} deploy --redeploy --no-backup"
  railsctl_info "  2. Configure UFW firewall rules if remote access is required for port ${INIT_NGINX_PORT}."
}

###############################################################################
# Main entry point for INIT
###############################################################################
init_main() {
  railsctl_load_global
  init_reset_variables

  trap 'init_on_exit "$?"' EXIT

  init_parse_args "$@"

  local preflight_rc=0
  set +e
  init_preflight
  preflight_rc=$?
  set -e

  case ${preflight_rc} in
    0)
      railsctl_info "Phase 1 complete: pre-flight dry-run passed and operator confirmed."
      ;;
    10|11)
      return 0
      ;;
    *)
      return "${preflight_rc}"
      ;;
  esac

  ROLLBACK_ARMED=true

  init_provision_user_and_dirs
  init_validate_phase_2

  init_provision_repo_and_env
  init_validate_phase_3

  init_provision_railsctl_registration
  init_validate_phase_4

  init_provision_runtime_and_proxy
  init_validate_phase_5

  ROLLBACK_ARMED=false
  railsctl_log "INIT" "status=COMPLETE service=${INIT_SERVICE_NAME} unit=${INIT_UNIT_NAME} nginx_port=${INIT_NGINX_PORT}"
  init_print_handoff
}

init_main "$@"
