#!/usr/bin/env bash
# bin/railsctl
# Main command dispatcher for railsctl lifecycle and deployment suite

set -euo pipefail

# Resolve physical path through symlink (/home/<user>/bin/railsctl -> .../railsctl/bin/railsctl)
SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SELF_DIR="$(dirname "${SELF_PATH}")"
export RAILSCTL_ROOT="$(cd "${SELF_DIR}/.." && pwd)"

# shellcheck source=/dev/null
source "${RAILSCTL_ROOT}/bin/railsctl.d/_common.sh"
railsctl_load_global

railsctl_alert "railsctl v${RAILSCTL_VERSION} — starting"

VALID_COMMANDS=(deploy start stop suspend resume backup test status version config help)

normalize_cmd() {
  local raw="${1,,}"
  case "${raw}" in
    -h|--help) printf 'help\n' ;;
    *) printf '%s\n' "${raw}" ;;
  esac
}

is_valid_command() {
  local candidate
  candidate="$(normalize_cmd "${1:-}")"
  local cmd
  for cmd in "${VALID_COMMANDS[@]}"; do
    [[ "${cmd}" == "${candidate}" ]] && return 0
  done
  return 1
}

dispatch_cmd() {
  local cmd="$1"
  shift || true
  local target="${RAILSCTL_COMMANDS_DIR}/${cmd}"

  if [[ ! -x "${target}" ]]; then
    railsctl_die "Command '${cmd}' is not yet implemented or not executable (${target})."
  fi

  "${target}" "$@"
}

if [[ $# -eq 0 ]]; then
  dispatch_cmd "help"
elif [[ $# -eq 1 ]]; then
  if is_valid_command "$1"; then
    CMD_NORM="$(normalize_cmd "$1")"
    dispatch_cmd "${CMD_NORM}"
  else
    railsctl_die "Missing command for service '$1' (or unknown command '$1'). Run 'railsctl help' for usage."
  fi
else
  if is_valid_command "$1"; then
    CMD_NORM="$(normalize_cmd "$1")"
    shift 1
    dispatch_cmd "${CMD_NORM}" "$@"
  elif is_valid_command "$2"; then
    SERVICE="$1"
    CMD_NORM="$(normalize_cmd "$2")"
    shift 2
    dispatch_cmd "${CMD_NORM}" "${SERVICE}" "$@"
  else
    railsctl_die "Unknown command '$2' (and '$1' is not a recognized command). Run 'railsctl help' for available commands."
  fi
fi

railsctl_alert "railsctl v${RAILSCTL_VERSION} — complete"
